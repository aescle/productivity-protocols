{
  "name": "productivity-protocols",
  "version": "0.1.1",
  "type": "module",
  "description": "An open, evidence-graded bank of health and performance protocols: behaviors, triggers, progression ladders, and citations. Queryable by agents over MCP.",
  "license": "MIT",
  "author": "Aescle",
  "homepage": "https://protocols.aescle.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aescle/productivity-protocols.git"
  },
  "bugs": {
    "url": "https://github.com/aescle/productivity-protocols/issues"
  },
  "keywords": [
    "protocols",
    "productivity",
    "performance",
    "health",
    "longevity",
    "deep-work",
    "evidence-based",
    "mcp",
    "model-context-protocol",
    "dataset",
    "agent"
  ],
  "exports": {
    ".": "./src/index.js",
    "./schema": "./schema/protocol.schema.json",
    "./data/*": "./data/*"
  },
  "bin": {
    "productivity-protocols": "mcp/server.mjs"
  },
  "files": [
    "src",
    "data",
    "schema",
    "mcp",
    "site",
    "scripts/validate.mjs",
    "scripts/generate-index.mjs",
    "scripts/generate-site.mjs",
    "LICENSE",
    "LICENSE-DATA.md",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-index.mjs",
    "validate": "node scripts/validate.mjs",
    "mcp": "node mcp/server.mjs",
    "test": "node scripts/validate.mjs"
  }
}
